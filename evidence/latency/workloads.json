{
  "description": "Seeded local coordinator and WMS-simulator workloads; injected delays are configuration, elapsed durations are measured.",
  "seed": 1070,
  "quantile_method": "nearest-rank, ceil(p*N)-1, no interpolation",
  "full_iterations_per_workload": 10000,
  "workloads": [
    { "id": "baseline", "name": "Sequential local baseline", "iterations": 50, "concurrency": 1, "shopify_delay_ms": [1, 2], "wms_delay_ms": [1, 3] },
    { "id": "burst", "name": "Concurrent local burst", "iterations": 200, "concurrency": 25, "shopify_delay_ms": [1, 3], "wms_delay_ms": [1, 5] },
    { "id": "delayed", "name": "Injected WMS delay", "iterations": 40, "concurrency": 10, "shopify_delay_ms": [1, 2], "wms_delay_ms": [5, 15] },
    { "id": "duplicates", "name": "Same-payload duplicate pairs", "iterations": 100, "concurrency": 20, "shopify_delay_ms": [1, 2], "wms_delay_ms": [1, 3], "duplicate_pairs": true },
    { "id": "cutoff", "name": "Post-cutoff rejection", "iterations": 20, "concurrency": 5, "initial_state": "WAVE_RELEASED", "shopify_delay_ms": [0, 0], "wms_delay_ms": [0, 0] },
    { "id": "unknown", "name": "Response loss after WMS-simulator success", "iterations": 30, "concurrency": 5, "shopify_delay_ms": [1, 2], "wms_delay_ms": [2, 5], "timeout_after_apply": true }
  ]
}
